# SmartNet Headless Seeder — configuration example.
# Copy to `.env` next to the binary (or run from the same directory) —
# the seeder will pick up the values via `dotenvy`.
#
# Main operational parameters (paths, disk limits, tracker list, reward
# address / passphrase) are configured in config.yaml, which is created automatically
# on first run. `.env` controls system flags and on-chain integration.

# --- Seeding Economics ---
# Participate in incentivized seeding: send signed heartbeats to trackers,
# accumulate K_up and receive payouts. Disabled with values 0/false/off/no.
# Default: ON.
ENABLE_INCENTIVIZED_SEEDING=1

# --- Official Repository (on-chain registry scanner) ---
# Comma-separated pool of SmartHoldem REST nodes. Without it, the built-in
# mainnet pool (node0..node3.smartholdem.io + node0.sth.cx) is used.
# SMARTHOLDEM_NODES=node0.smartholdem.io,node1.smartholdem.io

# Trusted developers registry address.
OFFICIAL_DEVELOPERS=SdevsH3kMbcCFWnyYVtD2UYnBQQm66MxDn

# Approved dApp registry address (by appId).
OFFICIAL_DAPPS=SdAppjWaQf4v2JjuubvtwsKe3yuUCuq8i8

# Comma-separated fallback list of developers (used if blockchain
# is unavailable at startup). Always supplemented with the ORACLE admin address.
# DEVELOPERS=Saddress1,Saddress2

# --- Logging Management ---
# Standard tracing-subscriber filter (example: smartnet_seeder=debug).
# RUST_LOG=smartnet_seeder=info
