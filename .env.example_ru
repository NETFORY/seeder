# SmartNet Headless Seeder — пример конфигурации.
# Скопируйте в `.env` рядом с бинарником (или запускайте из той же директории) —
# сидер подхватит значения через `dotenvy`.
#
# Основные операционные параметры (пути, лимиты диска, список трекеров, reward
# address / passphrase) настраиваются в config.yaml, который создаётся автоматически
# при первом запуске. `.env` управляет системными флагами и он-чейн интеграцией.

# --- Экономика сидинга ---
# Участвовать в оплачиваемой раздаче: слать подписанные heartbeat'ы трекерам,
# копить K_up и получать выплаты. Отключается значениями 0/false/off/no.
# По умолчанию ON.
ENABLE_INCENTIVIZED_SEEDING=1

# --- Official Repository (сканер он-чейн реестров) ---
# Пул REST-узлов SmartHoldem через запятую. Без него используется встроенный
# mainnet-пул (node0..node3.smartholdem.io + node0.sth.cx).
# SMARTHOLDEM_NODES=node0.smartholdem.io,node1.smartholdem.io

# Адрес-реестр доверенных разработчиков.
OFFICIAL_DEVELOPERS=SdevsH3kMbcCFWnyYVtD2UYnBQQm66MxDn

# Адрес-реестр одобренных dApp (по appId).
OFFICIAL_DAPPS=SdAppjWaQf4v2JjuubvtwsKe3yuUCuq8i8

# Fallback-список разработчиков через запятую (используется, если блокчейн
# недоступен при старте). Всегда дополняется адресом ORACLE-админа.
# DEVELOPERS=Saddress1,Saddress2

# --- Управление логированием ---
# Стандартный фильтр tracing-subscriber (пример: smartnet_seeder=debug).
# RUST_LOG=smartnet_seeder=info
